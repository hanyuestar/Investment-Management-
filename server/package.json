{
  "name": "investment-manager-server",
  "version": "4.0.0",
  "private": true,
  "description": "个人投资资产管理系统 · 后端（Express + SQLite）",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test:calc": "node test/calc.test.js",
